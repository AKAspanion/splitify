{
  "name": "splitify",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "next dev -p 2140",
    "build": "next build",
    "postbuild": "node scripts/build-sw.mjs",
    "build:hosting": "next build",
    "check:hosting": "node scripts/check-hosting-build.mjs",
    "start": "next start",
    "lint": "eslint .",
    "test": "vitest run",
    "test:rules": "pnpm dlx firebase-tools@15.34.2 emulators:exec --only auth,dataconnect --project demo-splitify \"vitest run --config vitest.rules.config.mts\"",
    "dataconnect:generate": "pnpm dlx firebase-tools@15.34.2 dataconnect:sdk:generate",
    "deploy:functions": "pnpm dlx firebase-tools@15.34.2 deploy --only functions",
    "deploy:dataconnect": "pnpm dlx firebase-tools@15.34.2 deploy --only dataconnect",
    "emulators": "pnpm dlx firebase-tools@15.34.2 emulators:start --project demo-splitify --import .emulator-data --export-on-exit .emulator-data",
    "format": "prettier --write .",
    "postinstall": "pnpm dataconnect:generate",
    "ngrok": "ngrok http --domain=rational-driving-barnacle.ngrok-free.app 2140",
    "functions:build": "pnpm --dir functions build",
    "functions:install": "pnpm --dir functions install --frozen-lockfile"
  },
  "dependencies": {
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-progress": "^1.2.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-toggle": "^1.2.1",
    "@simplewebauthn/browser": "^14.0.0",
    "@tanstack/react-query": "^5.105.3",
    "@tanstack/react-query-persist-client": "^5.106.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "dotenv": "^18.0.9",
    "firebase": "^13.2.0",
    "idb-keyval": "^6.3.0",
    "lucide-react": "^1.68.0",
    "next": "^16.4.5",
    "next-nprogress-bar": "^2.4.7",
    "next-themes": "^0.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-intersection-observer": "^11.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss-animate": "^1.0.7",
    "uid": "^2.0.2",
    "use-debounce": "^10.1.1",
    "vaul": "^1.1.2",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.4",
    "@types/node": "^24",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.14.0",
    "eslint-config-next": "^16.4.5",
    "fake-indexeddb": "^6.2.7",
    "firebase-admin": "^14.5.0",
    "firebase-functions": "^7.4.0",
    "postcss": "^8.5.32",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.4",
    "typescript": "6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  },
  "packageManager": "pnpm@11.0.8"
}
