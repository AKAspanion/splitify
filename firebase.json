{
  "dataconnect": {
    "source": "dataconnect"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "runtime": "nodejs24",
      "predeploy": ["pnpm --dir \"$RESOURCE_DIR\" build"],
      "ignore": ["node_modules", ".git", "src", "firebase-debug.log", "*.local"]
    }
  ],
  "emulators": {
    "singleProjectMode": true,
    "hub": { "host": "127.0.0.1", "port": 2141 },
    "auth": { "host": "127.0.0.1", "port": 2142 },
    "dataconnect": {
      "host": "127.0.0.1",
      "port": 2143,
      "postgresPort": 2144
    },
    "functions": { "host": "127.0.0.1", "port": 2145 },
    "eventarc": { "host": "127.0.0.1", "port": 2146 },
    "pubsub": { "host": "127.0.0.1", "port": 2147 },
    "hosting": { "host": "127.0.0.1", "port": 2148 },
    "ui": { "enabled": true, "host": "127.0.0.1", "port": 2149 },
    "logging": { "host": "127.0.0.1", "port": 2150 },
    "tasks": { "host": "127.0.0.1", "port": 2151 }
  },
  "hosting": {
    "public": "out",
    "cleanUrls": true,
    "trailingSlash": true,
    "rewrites": [
      {
        "source": "/api/reports/**",
        "function": {
          "functionId": "reports",
          "region": "asia-south1"
        }
      },
      {
        "source": "/api/webauthn/**",
        "function": {
          "functionId": "webauthn",
          "region": "asia-south1"
        }
      },
      {
        "source": "/groups/*/expense/*",
        "destination": "/groups/_/expense/_/index.html"
      },
      {
        "source": "/groups/*/expense",
        "destination": "/groups/_/expense/index.html"
      },
      {
        "source": "/groups/*/edit",
        "destination": "/groups/_/edit/index.html"
      },
      {
        "source": "/groups/*/settle",
        "destination": "/groups/_/settle/index.html"
      },
      {
        "source": "/groups/*/settings",
        "destination": "/groups/_/settings/index.html"
      },
      {
        "source": "/groups/*/add-member",
        "destination": "/groups/_/add-member/index.html"
      },
      {
        "source": "/groups/*/activity",
        "destination": "/groups/_/activity/index.html"
      },
      {
        "source": "/groups/*",
        "destination": "/groups/_/index.html"
      },
      {
        "source": "/expense/*/edit",
        "destination": "/expense/_/edit/index.html"
      },
      {
        "source": "/friends/*/edit/contact",
        "destination": "/friends/_/edit/contact/index.html"
      },
      {
        "source": "/friends/*",
        "destination": "/friends/_/index.html"
      },
      {
        "source": "/activity/*",
        "destination": "/activity/_/index.html"
      }
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          },
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          },
          {
            "key": "X-Frame-Options",
            "value": "DENY"
          },
          {
            "key": "Referrer-Policy",
            "value": "strict-origin-when-cross-origin"
          },
          {
            "key": "Permissions-Policy",
            "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
          },
          {
            "key": "Cross-Origin-Opener-Policy",
            "value": "same-origin-allow-popups"
          },
          {
            "key": "Content-Security-Policy",
            "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://apis.google.com https://www.gstatic.com https://pagead2.googlesyndication.com https://*.googlesyndication.com https://*.doubleclick.net https://googleads.g.doubleclick.net https://adservice.google.com https://www.googletagservices.com https://partner.googleadservices.com https://tpc.googlesyndication.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; connect-src 'self' https://asia-south1-splitify-416321.cloudfunctions.net https://*.googleapis.com https://*.firebaseio.com https://firebaseinstallations.googleapis.com https://fcmregistrations.googleapis.com https://pagead2.googlesyndication.com https://*.googlesyndication.com https://*.doubleclick.net https://googleads.g.doubleclick.net https://adservice.google.com https://www.googletagservices.com https://partner.googleadservices.com https://tpc.googlesyndication.com; frame-src 'self' https://splitify-416321.firebaseapp.com https://accounts.google.com https://pagead2.googlesyndication.com https://*.googlesyndication.com https://*.doubleclick.net https://googleads.g.doubleclick.net https://adservice.google.com https://www.googletagservices.com https://partner.googleadservices.com https://tpc.googlesyndication.com; worker-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests"
          }
        ]
      },
      {
        "source": "/_next/static/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      },
      {
        "source": "/auth/action{,/**}",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-store"
          },
          {
            "key": "Referrer-Policy",
            "value": "strict-origin"
          }
        ]
      },
      {
        "source": "/.well-known/assetlinks.json",
        "headers": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ]
      }
    ]
  }
}
