{
  "dataconnect": {
    "source": "dataconnect"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "runtime": "nodejs24",
      "predeploy": ["yarn --cwd \"$RESOURCE_DIR\" build"],
      "ignore": ["node_modules", ".git", "src", "firebase-debug.log", "*.local"]
    }
  ],
  "emulators": {
    "auth": {
      "port": 9099
    },
    "dataconnect": {
      "port": 9399
    },
    "functions": {
      "port": 5001
    },
    "ui": {
      "enabled": false
    },
    "hosting": {
      "port": 5050
    }
  },
  "hosting": {
    "public": "out",
    "cleanUrls": true,
    "trailingSlash": true,
    "rewrites": [
      {
        "source": "/groups/*/expense/*",
        "destination": "/groups/_/expense/_/index.html"
      },
      {
        "source": "/groups/*/expense",
        "destination": "/groups/_/expense/index.html"
      },
      {
        "source": "/groups/*/edit",
        "destination": "/groups/_/edit/index.html"
      },
      {
        "source": "/groups/*/settle",
        "destination": "/groups/_/settle/index.html"
      },
      {
        "source": "/groups/*/settings",
        "destination": "/groups/_/settings/index.html"
      },
      {
        "source": "/groups/*/add-member",
        "destination": "/groups/_/add-member/index.html"
      },
      {
        "source": "/groups/*/activity",
        "destination": "/groups/_/activity/index.html"
      },
      {
        "source": "/groups/*",
        "destination": "/groups/_/index.html"
      },
      {
        "source": "/expense/*/edit",
        "destination": "/expense/_/edit/index.html"
      },
      {
        "source": "/friends/*/edit/contact",
        "destination": "/friends/_/edit/contact/index.html"
      },
      {
        "source": "/friends/*",
        "destination": "/friends/_/index.html"
      },
      {
        "source": "/activity/*",
        "destination": "/activity/_/index.html"
      },
      {
        "source": "**",
        "destination": "/coming-soon/index.html"
      }
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          },
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          },
          {
            "key": "X-Frame-Options",
            "value": "DENY"
          },
          {
            "key": "Referrer-Policy",
            "value": "strict-origin-when-cross-origin"
          },
          {
            "key": "Permissions-Policy",
            "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
          },
          {
            "key": "Cross-Origin-Opener-Policy",
            "value": "same-origin-allow-popups"
          }
        ]
      },
      {
        "source": "/_next/static/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      },
      {
        "source": "/.well-known/assetlinks.json",
        "headers": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ]
      }
    ]
  }
}
