{
  "consent": null,
  "workflow": {
    "git": {
      "message": "free",
      "ticket": "none",
      "base": "main",
      "branch": "feat/<topic>",
      "squash": false,
      "push": "at-finish",
      "merge-request": "at-finish"
    },
    "checks": {
      "commands": {
        "typecheck": "yarn tsc --noEmit",
        "lint": "yarn lint",
        "lint-fix": null,
        "format-check": "yarn prettier --check .",
        "test": "yarn test",
        "e2e": null
      }
    },
    "run": {
      "unattended": true
    }
  }
}
