{
  "consent": null,
  "workflow": {
    "git": {
      "message": "free",
      "ticket": "none",
      "base": "main",
      "branch": "feat/<topic>",
      "squash": false,
      "push": "at-finish",
      "merge-request": "at-finish"
    },
    "checks": {
      "commands": {
        "typecheck": "pnpm tsc --noEmit",
        "lint": "pnpm lint",
        "lint-fix": null,
        "format-check": "pnpm prettier --check .",
        "test": "pnpm test",
        "e2e": null
      }
    },
    "run": {
      "unattended": true
    }
  }
}
